rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isBlocked() {
      return signedIn()
        && exists(/databases/$(database)/documents/blocked_users/$(request.auth.uid));
    }

    match /admins/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    match /blocked_users/{blockedId} {
      allow read: if signedIn()
                  && (request.auth.uid == blockedId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow create: if signedIn()
                    && request.auth.uid == userId
                    && !isBlocked()
                    && request.resource.data.approved == false
                    && !request.resource.data.keys().hasAny([
                      'marks', 'updated_at', 'approved_at'
                    ])
                    && request.resource.data.keys().hasOnly([
                      'first_name', 'last_name', 'registration_number',
                      'user_name', 'email', 'photo_url', 'github_id',
                      'approved', 'created_at'
                    ]);

      allow read: if signedIn()
                  && !isBlocked()
                  && (request.auth.uid == userId || isAdmin());

      allow update, delete: if isAdmin();
    }
  }
}
